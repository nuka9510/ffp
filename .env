APP_PROFILE=dev # 서버 실행 Profile
APP_TIMEZONE=UTC # 서버 타임존
APP_XSS=on # 서버 xss 필터링 활성화
APP_WORKER_NUM=4 # 서버 워커 수
# APP_WATCH=watch # 서버 소스 변경 감지 활성화
APP_SCHEME=http:// # 서버 프로토콜 스킴
APP_HOST=localhost # 서버 호스트명
APP_PORT=8081 # 서버 포트
APP_LOG_LEVEL=INFO # 서버 기본 로그레벨
# APP_DEBUG=debug # 서버 디버그 로그 활성화
APP_SERVER_LOG=./logs/frankenphp-server.log # 서버 기본 로그파일 경로
APP_FRANKENPHP_LOG=./logs/frankenphp-application.log # frankenphp, php 로그파일 경로